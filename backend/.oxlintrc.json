{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": "error",
    "eslint/no-debugger": "error",
    "eslint/no-console": "warn"
  },
  "env": {
    "builtin": true
  }
}
